{
    "name": "alma-dingtalk-bridge",
    "version": "2.3.0",
    "type": "module",
    "description": "DingTalk channel bridge for Alma — Stream mode intake, full agent turn via Alma's internal WebSocket protocol",
    "author": {
        "name": "JasonChou"
    },
    "license": "MIT",
    "main": "main.js",
    "scripts": {
        "build": "bun scripts/build.mjs",
        "test": "bun scripts/test.mjs",
        "test:offline": "bun scripts/test.mjs",
        "test:unit": "bun scripts/test.mjs --unit",
        "test:integration": "bun scripts/test.mjs --integration",
        "typecheck": "tsc -p .",
        "check:bundle": "bun scripts/check-bundle.mjs",
        "migrate:data": "node scripts/migrate-data.mjs"
    },
    "dependencies": {
        "dingtalk-stream": "2.1.6-beta.1",
        "ws": "8.22.1"
    },
    "devDependencies": {
        "@types/node": "22.20.5",
        "typescript": "5.9.3"
    },
    "packageManager": "bun@1.3.14",
    "engines": {
        "bun": "1.3.14"
    }
}
