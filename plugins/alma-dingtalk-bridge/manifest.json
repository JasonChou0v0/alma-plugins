{
    "id": "alma-dingtalk-bridge",
    "name": "DingTalk Bridge",
    "version": "2.4.1",
    "description": "把钉钉机器人接成 Alma 的聊天渠道：Stream 模式收消息，驱动完整 agent（工具/技能/项目工作区），回复推回钉钉。",
    "author": {
        "name": "JasonChou"
    },
    "main": "main.js",
    "engines": {
        "alma": "^0.4.0"
    },
    "type": "integration",
    "permissions": [
        "network:fetch",
        "network:domain:dingtalk.com",
        "network:domain:api.dingtalk.com",
        "network:domain:oapi.dingtalk.com",
        "network:localhost",
        "chat:read",
        "chat:write",
        "tools:register",
        "notifications",
        "settings:write"
    ],
    "activationEvents": [
        "onStartup"
    ],
    "contributes": {
        "commands": [
            {
                "id": "dingtalkBridge.status",
                "title": "钉钉桥接：查看状态"
            },
            {
                "id": "dingtalkBridge.restart",
                "title": "钉钉桥接：重连"
            },
            {
                "id": "dingtalkBridge.clearSessions",
                "title": "钉钉桥接：清空会话映射"
            },
            {
                "id": "dingtalkBridge.testAlma",
                "title": "钉钉桥接：连通性自检"
            },
            {
                "id": "dingtalkBridge.setSecret",
                "title": "钉钉桥接：设置安全密钥"
            }
        ],
        "components": {
            "statusBar": [
                {
                    "id": "alma-dingtalk-bridge.status",
                    "alignment": "right",
                    "priority": 90
                }
            ]
        },
        "configuration": {
            "title": "DingTalk Bridge",
            "properties": {
                "dingtalkBridge.clientId": {
                    "type": "string",
                    "default": "",
                    "description": "钉钉应用 AppKey（Client ID）"
                },
                "dingtalkBridge.clientSecretSecretKey": {
                    "type": "string",
                    "default": "dingtalk.clientSecret",
                    "description": "AppSecret 在 context.storage.secrets 中的键名；通过「设置安全密钥」命令输入，不允许明文回退。"
                },
                "dingtalkBridge.robotCode": {
                    "type": "string",
                    "default": "",
                    "description": "机器人 RobotCode，留空则沿用 clientId"
                },
                "dingtalkBridge.almaApiPort": {
                    "type": "number",
                    "default": 23001,
                    "description": "Alma 本地 API 端口（默认 23001）"
                },
                "dingtalkBridge.defaultModel": {
                    "type": "string",
                    "default": "",
                    "description": "使用的模型，格式 providerId:modelId。留空则跟随 Alma 默认模型"
                },
                "dingtalkBridge.workspaceId": {
                    "type": "string",
                    "default": "",
                    "description": "绑定到哪个本地项目（工作区 ID）。留空跟随 Alma 默认工作区。可随时用 /use 命令切换"
                },
                "dingtalkBridge.mode": {
                    "type": "string",
                    "default": "per-chat",
                    "enum": [
                        "per-chat",
                        "per-sender",
                        "single"
                    ],
                    "description": "会话隔离策略：per-chat 每群一个线程；per-sender 群内每人各自一个线程；single 全部共用一个线程"
                },
                "dingtalkBridge.groupAgentPolicy": {
                    "type": "string",
                    "default": "refuse",
                    "enum": [
                        "refuse",
                        "fullTools"
                    ],
                    "description": "群聊开关：refuse（默认）拒绝群内生成，仍允许已授权命令；fullTools 开放已授权群的聊天，其中只有 adminUnionIds 内的管理员进入完整 Agent，普通白名单成员走不提供工具的独立文本接口。私聊同样按管理员/普通成员隔离。旧 noTools 按 refuse 处理。"
                },
                "dingtalkBridge.allowedUnionIds": {
                    "type": "string",
                    "default": "",
                    "description": "用户白名单：仅允许事件 UnionID 或同企业私聊官方查询补全的 UnionID 匹配这些名单的用户使用（逗号分隔）。留空则拒绝所有入站（无开放模式）。nick: 占位 ID 永不可授权。"
                },
                "dingtalkBridge.allowedConversationIds": {
                    "type": "string",
                    "default": "",
                    "description": "群白名单：仅允许这些 conversationId 的群聊（逗号分隔）。留空则拒绝所有群聊。单聊不受此约束，仍由 allowedUnionIds 约束。"
                },
                "dingtalkBridge.adminUnionIds": {
                    "type": "string",
                    "default": "",
                    "description": "管理员 UnionID（逗号分隔）。控制工作区切换、Agent 新建/停止及授权管理；普通成员的 /new 仅重置纯聊天，/stop 仅停止本人纯聊天。管理员仍须在用户白名单，只有 /allow group 可作为未授权群的授权入口。"
                },
                "dingtalkBridge.streamingReply": {
                    "type": "boolean",
                    "default": false,
                    "description": "流式回复：边生成边推送（最多 3 段）。钉钉里逐段推送容易刷屏，默认关闭，生成完一次性发送。"
                },
                "dingtalkBridge.replyOnToolUse": {
                    "type": "boolean",
                    "default": true,
                    "description": "使用工具时先推一条「正在处理…」提示（整轮只发一次，不会按工具刷屏）"
                },
                "dingtalkBridge.logRawPayload": {
                    "type": "boolean",
                    "default": false,
                    "description": "排查问题时临时开启：本机归档入站/出站原始载荷（含聊天全文，webhook 地址已脱敏），文件权限 0600；到期自动清理，禁止提交或公开分享。"
                },
                "dingtalkBridge.rawPayloadRetentionDays": {
                    "type": "number",
                    "default": 7,
                    "description": "原始载荷归档保留天数（1–90），超期文件自动删除"
                },
                "dingtalkBridge.robotName": {
                    "type": "string",
                    "default": "豆豆",
                    "description": "机器人自己的昵称。用于从 @ 提及里排除机器人自己，避免把「@豆豆」当成被 @ 的人"
                }
            }
        }
    },
    "keywords": [
        "dingtalk",
        "钉钉",
        "channel",
        "bridge",
        "robot",
        "stream"
    ]
}
